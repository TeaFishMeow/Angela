# ===== 大体积资产：绝不入 git（用网盘/本地同步）=====
# 音频/视频 stems 与成片
*.wav
*.mp3
*.flac
*.aac
*.ogg
*.mp4
*.mkv
*.mov
*.webm
# Live2D / 3D 模型本体
*.model3.json
*.physics3.json
*.moc3
*.mtn
*.vrm
*.glb
*.gltf
# 资产目录（保留结构，不保留内容）
assets/
!assets/**/.gitkeep
# 但保留小体积的样例数据（在 data/samples 下，显式放行）
!data/samples/**

# ===== Python（后端）=====
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.env
.pytest_cache/
.ipynb_checkpoints/

# ===== Node / 前端 =====
node_modules/
dist/
build/
.vite/
.cache/
*.log
npm-debug.log*
yarn-error.log*

# ===== RVC / Applio 产物与模型 =====
*.pth
*.index
*.pt
*.onnx
runs/
weights/
logs_rvc/

# ===== Claude Code 本地配置（用户私有，不入库）=====
.claude/settings.local.json

# ===== 编辑器 / 系统 =====
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ===== 临时与缓存 =====
tmp/
temp/
*.tmp
